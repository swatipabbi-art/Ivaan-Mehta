rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Security Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'swatipabbi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'role', 'proActive', 'proCurrency', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'role', 'proActive', 'proCurrency', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['member', 'owner']
        && data.proActive is bool
        && data.proCurrency is string && data.proCurrency in ['USD', 'INR']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateUserInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.updatedAt is timestamp;
    }

    function isValidProAccessRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId', 'uid', 'requesterName', 'requesterEmail',
          'currency', 'amountLabel', 'paymentReference', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'uid', 'requesterName', 'requesterEmail',
          'currency', 'amountLabel', 'paymentReference', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.requestId)
        && data.requestId == requestId
        && isValidId(data.uid)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
        && data.requesterEmail is string && data.requesterEmail.size() >= 3 && data.requesterEmail.size() <= 254
        && data.requesterEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.currency is string && data.currency in ['USD', 'INR']
        && data.amountLabel is string && data.amountLabel in ['$29 USD', '₹100']
        && data.paymentReference is string && data.paymentReference.size() >= 2 && data.paymentReference.size() <= 120
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == 'member' && incoming().proActive == false)
        );

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'proActive', 'proCurrency', 'updatedAt'])) ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().proActive == existing().proActive
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'proCurrency', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateUserInfo(incoming(), userId)
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidPrivateUserInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isValidId(userId) && docId == 'info' && isAdmin();
      }
    }

    match /proRequests/{requestId} {
      allow get: if isValidId(requestId) && isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isValidId(requestId)
        && isVerifiedUser()
        && isValidProAccessRequest(incoming(), requestId)
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isAdmin()
        && isValidProAccessRequest(incoming(), requestId)
        && existing().status == 'pending'
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
